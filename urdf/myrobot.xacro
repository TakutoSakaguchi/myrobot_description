<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="myrobot" 
    params="joint01_lower_limit
            joint01_upper_limit
            joint02_lower_limit
            joint02_upper_limit
            joint03_lower_limit
            joint03_upper_limit
            joint04_lower_limit
            joint04_upper_limit
            joint05_lower_limit
            joint05_upper_limit
            joint06_lower_limit
            joint06_upper_limit
            joint07_lower_limit
            joint07_upper_limit
            joint08_lower_limit
            joint08_upper_limit
            joint09_lower_limit
            joint09_upper_limit
            joint10_lower_limit
            joint10_upper_limit
            joint01_effort_limit joint01_velocity_limit
            joint02_effort_limit joint02_velocity_limit
            joint03_effort_limit joint03_velocity_limit
            joint04_effort_limit joint04_velocity_limit
            joint05_effort_limit joint05_velocity_limit
            joint06_effort_limit joint06_velocity_limit
            joint07_effort_limit joint07_velocity_limit
            joint08_effort_limit joint08_velocity_limit
            joint09_effort_limit joint09_velocity_limit
            joint10_effort_limit joint10_velocity_limit
            arm_color
            ">

    <!-- ================= Joint 0 ================= -->
    <joint name="joint00" type="fixed">
      <parent link="base_link" />
      <child link="link01" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="link01">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com01.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com01.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="2.529e-12 0 0.040805" rpy="0 0 0"/>
        <mass value="0.987927"/>
        <inertia ixx="0.001363" ixy="1.036e-18" ixz="-2.991e-15" iyy="0.001363" iyz="0" izz="0.001426"/>
      </inertial>
    </link>

    <!-- ================= Joint 1 ================= -->
    <joint name="joint01" type="revolute">
      <parent link="link01" />
      <child link="link02" />00
      <origin xyz="0 0 -0.084" rpy="0 0 0"/>
      <limit lower="${joint01_lower_limit}" upper="${joint01_upper_limit}" effort="${joint01_effort_limit}" velocity="${joint01_velocity_limit}"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link02">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com02.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com02.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.001015 1.837e-12 0.031665" rpy="0 0 0"/>
        <mass value="0.705618"/>
        <inertia ixx="0.0004845" ixy="-4.897e-15" ixz="-4.179279e-6"
                iyy="0.0005896" iyz="-7.564e-15" izz="0.0006012"/>
      </inertial>
    </link>

    <!-- ================= Joint 2  ================= -->
    <joint name="joint02" type="revolute">
      <parent link="link02"/>
      <child link="link03"/>
      <origin xyz="0 0 -0.0385" rpy="0 0 0"/>
      <limit lower="${joint02_lower_limit}" upper="${joint02_upper_limit}" effort="${joint02_effort_limit}" velocity="${joint02_velocity_limit}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link03">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.370"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com03.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.370"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com03.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00029 -2.571e-13 -0.135978" rpy="0 0 0"/>
        <mass value="2.518019"/>
        <inertia ixx="0.03772" ixy="-1.633e-15" ixz="9.9423617e-5"
                iyy="0.04126" iyz="8.79e-14" izz="0.00532"/>
      </inertial>
    </link>

    <!-- ================= Joint 3 ================= -->
    <joint name="joint03" type="revolute">
      <parent link="link03" />
      <child link="link04" />
      <origin xyz="0 0 -0.370" rpy="0 0 0"/>
      <limit lower="${joint03_lower_limit}" upper="${joint03_upper_limit}" effort="${joint03_effort_limit}" velocity="${joint03_velocity_limit}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link04">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.300"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com04.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.300"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com04.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.000228 0.001307 -0.053587" rpy="0 0 0"/>
        <mass value="2.663893"/>
        <inertia ixx="0.04266" ixy="-7.95006e-7" ixz="-3.3404576e-5"
                iyy="0.04593" iyz="-0.0004672" izz="0.006191"/>
      </inertial>
    </link>

    <!-- ================= Joint 4 ================= -->
    <joint name="joint04" type="revolute">
      <parent link="link04" />
      <child link="link05" />
      <origin xyz="0 0 -0.4099" rpy="0 0 0"/>
      <limit lower="${joint04_lower_limit}" upper="${joint04_upper_limit}" effort="${joint04_effort_limit}" velocity="${joint04_velocity_limit}"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link05">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.005"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com05.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.005"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com05.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.000639 0 0.032486" rpy="0 0 0"/>
        <mass value="0.656091"/>
        <inertia ixx="0.0005734" ixy="-2.047e-16" ixz="-3.388729e-6"
                iyy="0.0006868" iyz="2.988e-16" izz="0.0005789"/>
      </inertial>
    </link>

    <!-- ================= Joint 5 ================= -->
    <joint name="joint05" type="revolute">
      <parent link="link05" />
      <child link="link06" />
      <origin xyz="0 0 -0.05975" rpy="0 0 0"/>
      <limit lower="${joint05_lower_limit}" upper="${joint05_upper_limit}" effort="${joint05_effort_limit}" velocity="${joint05_velocity_limit}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link06">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.260"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com06.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.260"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com06.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00029 0 -0.098217" rpy="0 0 0"/>
        <mass value="1.560054"/>
        <inertia ixx="0.01134" ixy="1.01e-15" ixz="3.6208465e-5"
                iyy="0.01358" iyz="1.59e-15" izz="0.003057"/>
      </inertial>
    </link>

    <!-- ================= Joint 6 ================= -->
    <joint name="joint06" type="revolute">
      <parent link="link06" />
      <child link="link07" />
      <origin xyz="0 0 -0.260" rpy="0 0 0"/>
      <limit lower="${joint06_lower_limit}" upper="${joint06_upper_limit}" effort="${joint06_effort_limit}" velocity="${joint06_velocity_limit}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link07">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.2425"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com07.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.2425"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com07.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.000201 -0.00165 -0.051976" rpy="0 0 0"/>
        <mass value="2.08243"/>
        <inertia ixx="0.0176" ixy="7.18425e-7" ixz="-2.1360601e-5"
                iyy="0.0196" iyz="0.0002948" izz="0.00427"/>
      </inertial>
    </link>

    <!-- ================= Joint 7 ================= -->
    <joint name="joint07" type="revolute">
      <parent link="link07" />
      <child link="link08" />
      <origin xyz="0 0 -0.3099" rpy="0 0 0"/>
      <limit lower="${joint07_lower_limit}" upper="${joint07_upper_limit}" effort="${joint07_effort_limit}" velocity="${joint07_velocity_limit}"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link08">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.001"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com08.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.001"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com08.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.000436 0 0.026612" rpy="0 0 0"/>
        <mass value="0.471114"/>
        <inertia ixx="0.0003105" ixy="4.698e-16" ixz="-1.168653e-6"
                iyy="0.0004031" iyz="-2.79e-16" izz="0.0004159"/>
      </inertial>
    </link>

    <!-- ================= Joint 8 ================= -->
    <joint name="joint08" type="revolute">
      <parent link="link08" />
      <child link="link09" />
      <origin xyz="0 0 -0.04625" rpy="0 0 0"/>
      <limit lower="${joint08_lower_limit}" upper="${joint08_upper_limit}" effort="${joint08_effort_limit}" velocity="${joint08_velocity_limit}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link09">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.207"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com09.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.207"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com09.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.000196 0 -0.078945" rpy="0 0 0"/>
        <mass value="1.234544"/>
        <inertia ixx="0.005759" ixy="8.275e-16" ixz="1.3680762e-5"
                iyy="0.007462" iyz="6.574e-16" izz="0.002274"/>
      </inertial>
    </link>

    <!-- ================= Joint 9 ================= -->
    <joint name="joint09" type="revolute">
      <parent link="link09" />
      <child link="link10" />
      <origin xyz="0 0 -0.207" rpy="0 0 0"/>
      <limit lower="${joint09_lower_limit}" upper="${joint09_upper_limit}" effort="${joint09_effort_limit}" velocity="${joint09_velocity_limit}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="link10">
      <visual>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.150"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/com10.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 0" xyz="0 0 -0.150"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/com10.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="2.209e-13 0.000862 0.003082" rpy="0 0 0"/>
        <mass value="1.715626"/>
        <inertia ixx="0.009467" ixy="-6.944e-16" ixz="6.965e-16"
                iyy="0.01101" iyz="-0.0001014" izz="0.003366"/>
      </inertial>
    </link>

    <!-- ================= Joint 10 ================= -->
    <joint name="joint10" type="revolute">
      <parent link="link10" />
      <child link="hand_link" />
      <origin xyz="0 0 -0.250" rpy="0 0 0"/>
      <limit lower="${joint10_lower_limit}" upper="${joint10_upper_limit}" effort="${joint10_effort_limit}" velocity="${joint10_velocity_limit}"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <!-- ================= Gazebo 設定 ================= -->
    <xacro:macro name="gazebo_material" params="link_name">
      <gazebo reference="${link_name}">
        <material>Gazebo/White</material>
      </gazebo>
    </xacro:macro>

    <xacro:gazebo_material link_name="link01"/>
    <xacro:gazebo_material link_name="link02"/>
    <xacro:gazebo_material link_name="link03"/>
    <xacro:gazebo_material link_name="link04"/>
    <xacro:gazebo_material link_name="link05"/>
    <xacro:gazebo_material link_name="link06"/>
    <xacro:gazebo_material link_name="link07"/>
    <xacro:gazebo_material link_name="link08"/>
    <xacro:gazebo_material link_name="link09"/>
    <xacro:gazebo_material link_name="link10"/>

  </xacro:macro>

</robot>
