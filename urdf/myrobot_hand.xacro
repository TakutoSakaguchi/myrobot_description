<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="myrobot_hand" 
    params="hand_joints_lower_limit
            hand_joints_upper_limit
            hand_joints_effort_limit
            hand_joints_velocity_limit
            hand_color
            ">

    <link name="HandMount_link">
      <visual>
        <origin rpy="3.14159 0 1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/HandMount.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${hand_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/HandMount.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.000264 -0.000049 0.023304" rpy="0 0 0"/>
        <mass value="0.205541"/>
        <inertia
          ixx="0.000095997183"
          ixy="-1.231e-7"
          ixz="1.41185e-7"
          iyy="0.0001288"
          iyz="2.4556e-8"
          izz="0.0001199"/>
      </inertial>
    </link>

    <!-- ================= Joint hand mount to HandFingerA_link ================= -->    
    <joint name="hand_joint" type="revolute">
      <parent link="HandMount_link" />
      <child link="HandFingerA_link" />
      <origin xyz="0.0 -0.012 -0.02575" rpy="0 0 0"/>
      <limit 
        lower="${hand_joints_lower_limit}" 
        upper="${hand_joints_upper_limit}" 
        effort="${hand_joints_effort_limit}" 
        velocity="${hand_joints_velocity_limit}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="HandFingerA_link">
      <visual>
        <origin rpy="3.14159 0 -1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/HandFingureA.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${hand_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 -1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/HandFingureA.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.001325 -3.967e-10 0.022033" rpy="0 0 0"/>
        <mass value="0.020568"/>
        <inertia
          ixx="0.000010584193"
          ixy="-1.041e-14"
          ixz="5.62926e-7"
          iyy="0.000004874099"
          iyz="0.0"
          izz="0.000006957021"/>
      </inertial>
    </link>

    <!-- ================= Joint hand finger B to hand fingerA ================= -->
    <joint name="hand_mimic_joint" type="revolute">
      <parent link="HandMount_link" />
      <child link="HandFingerB_link" />
      <origin xyz="0.0 0.012 -0.02575" rpy="0 0 0"/>
      <limit 
        lower="${hand_joints_lower_limit}" 
        upper="${hand_joints_upper_limit}" 
        effort="${hand_joints_effort_limit}" 
        velocity="${hand_joints_velocity_limit}"/>
      <axis xyz="-1 0 0"/>
      <mimic joint="hand_joint" multiplier="1" offset="0"/>
      <dynamics damping="1.0e-6" friction="0.8"/>
    </joint>

    <link name="HandFingerB_link">
      <visual>
        <origin rpy="3.14159 0 -1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/visual/HandFingureB.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${hand_color}"/>
      </visual>
      <collision>
        <origin rpy="3.14159 0 -1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://myrobot_description/meshes/collision/HandFingureB.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.001385 -0.000244 0.021686" rpy="0 0 0"/>
        <mass value="0.02096"/>
        <inertia
          ixx="0.000010837944"
          ixy="-7.082e-9"
          ixz="-5.33588e-7"
          iyy="0.000005007456"
          iyz="-1.10875e-7"
          izz="0.000007078359"/>
      </inertial>
    </link>

    <gazebo reference="HandMount_link">
      <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="HandFingerA_link">
      <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="HandFingerB_link">
      <material>Gazebo/Red</material>
    </gazebo>

  </xacro:macro>

</robot>
